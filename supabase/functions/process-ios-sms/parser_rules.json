{
  "version": 2,
  "_readme": "Shared preview-parsing rules used by BOTH the iOS App Intent (Swift) and the Dart mirror (lib/engine/parser/shared_preview_parser.dart). Regexes must stay compatible with Dart RegExp AND NSRegularExpression (ICU): no named groups, no \\b (differs for Arabic), group 1 is always the extracted value. Matching is case-insensitive. Pipeline: normalize digits -> apply currencyReplacements in order -> preserve thousands separators for validation -> match. Flutter's ParserEngine stays the source of truth; these rules only power the immediate notification preview.",
  "normalization": {
    "decimalMarks": ["٫"],
    "thousandsMarks": ["٬"],
    "currencyReplacements": [
      { "pattern": "ر\\.س\\.?", "replacement": "SAR" },
      { "pattern": "د\\.إ\\.?", "replacement": "AED" },
      { "pattern": "ج\\.م\\.?", "replacement": "EGP" },
      { "pattern": "﷼", "replacement": "SAR" },
      { "pattern": "ريال\\s+سعودي", "replacement": "SAR" },
      { "pattern": "ريال\\s+قطري", "replacement": "QAR" },
      { "pattern": "ريال\\s+عماني", "replacement": "OMR" },
      { "pattern": "درهم\\s+إماراتي|درهم\\s+اماراتي|درهم", "replacement": "AED" },
      { "pattern": "جنيه\\s+مصري|جنيه", "replacement": "EGP" },
      { "pattern": "دينار\\s+كويتي", "replacement": "KWD" },
      { "pattern": "دينار\\s+بحريني", "replacement": "BHD" },
      { "pattern": "دولار\\s+أمريكي|دولار\\s+امريكي|دولار", "replacement": "USD" },
      { "pattern": "ريال", "replacement": "SAR" }
    ]
  },
  "currencyPattern": "(?:^|[^A-Za-z])(SAR|AED|EGP|QAR|OMR|KWD|BHD|JOD|USD|EUR|GBP|JPY)(?![A-Za-z])",
  "ignoreKeywords": [
    "otp",
    "one time password",
    "verification code",
    "security code",
    "رمز الدخول",
    "رمز التحقق",
    "كود التحقق",
    "لا تشاركه",
    "عرض خاص",
    "promo",
    "promotion",
    "marketing",
    "coupon",
    "مبروك",
    "جائزة",
    "prize",
    "winner"
  ],
  "_declinedReadme": "DATA-01: a message matching a declinedKeywords entry (whole token; Arabic may carry one clitic prefix) reports a purchase that did not complete and is treated like ignoreKeywords, unless it also matches declinedExemptKeywords (the message itself is a refund/reversal). Mirrors app/lib/engine/parser/transaction_state_cues.dart.",
  "declinedKeywords": [
    "مرفوضة",
    "مرفوض",
    "تم رفض",
    "رفضت",
    "تم الرفض",
    "فشلت",
    "فاشلة",
    "فشل العملية",
    "فشل عملية",
    "فشل الدفع",
    "فشل السحب",
    "غير ناجحة",
    "غير ناجح",
    "لم تنجح",
    "لم تتم بنجاح",
    "لم يتم تنفيذ العملية",
    "لم يتم تنفيذ عملية",
    "تعذر إتمام",
    "تعذر اتمام",
    "تعذر تنفيذ",
    "رصيد غير كاف",
    "رصيد غير كافي",
    "رصيدك غير كاف",
    "رصيدك غير كافي",
    "الرصيد غير كاف",
    "الرصيد غير كافي",
    "عدم كفاية الرصيد",
    "تجاوز الحد",
    "تجاوزت الحد",
    "تجاوز حد",
    "تخطي الحد",
    "declined",
    "rejected",
    "unsuccessful",
    "not successful",
    "failed",
    "was not completed",
    "could not be completed",
    "not processed",
    "insufficient funds",
    "insufficient balance",
    "limit exceeded",
    "exceeded limit",
    "exceeds limit",
    "exceeds the limit",
    "exceeded the limit",
    "exceeds your limit",
    "exceeded your limit",
    "exceeds your credit limit",
    "exceeded your credit limit"
  ],
  "declinedExemptKeywords": [
    "استرداد",
    "استرجاع",
    "مسترد",
    "مستردة",
    "رد مبلغ",
    "إعادة مبلغ",
    "اعادة مبلغ",
    "عكس عملية",
    "عكس العملية",
    "عكس قيد",
    "refund",
    "refunded",
    "reversal",
    "reversed",
    "credited"
  ],
  "debitKeywords": [
    "عملية شراء",
    "شراء",
    "خصم",
    "سحب",
    "مدى",
    "سداد",
    "مشتريات",
    "pos",
    "purchase",
    "debit",
    "withdraw",
    "payment",
    "paid",
    "spent"
  ],
  "creditKeywords": [
    "إيداع",
    "ايداع",
    "حوالة واردة",
    "حواله وارده",
    "تحويل وارد",
    "استرداد",
    "راتب",
    "credited",
    "credit",
    "deposit",
    "received",
    "refund",
    "salary"
  ],
  "amountPatterns": [
    "(?:بمبلغ|بقيمة|مبلغ|قيمة)[\\s:]*([0-9][0-9,]*(?:\\.[0-9]+)?)",
    "(?:SAR|AED|EGP|QAR|OMR|KWD|BHD|JOD|USD|EUR|GBP|JPY)\\s*([0-9][0-9,]*(?:\\.[0-9]+)?)",
    "([0-9][0-9,]*(?:\\.[0-9]+)?)\\s*(?:SAR|AED|EGP|QAR|OMR|KWD|BHD|JOD|USD|EUR|GBP|JPY)",
    "(?:amount|amt)[\\s:]*([0-9][0-9,]*(?:\\.[0-9]+)?)"
  ],
  "merchantPatterns": [
    "(?:لدى|لدي)[\\s:]+([^\\n\\r؛;,]{2,40})",
    "(?:\\bat|@)\\s+([A-Za-z0-9&.'\\- ]{2,40})",
    "(?:من|from)\\s+(?!حساب|بطاق|card|account)([^\\n\\r؛;,]{2,40})",
    "(?:عند)\\s+(?!حساب)([^\\n\\r؛;,]{2,40})"
  ],
  "merchantStopPattern": "\\s+(?:في|بتاريخ|بمبلغ|بقيمة|بواسطة|برقم|on|via|using|with|dated|ending)\\s.*$",
  "last4Patterns": [
    "(?:بطاق[ةت]\\S*|ببطاقة|card)[^0-9\\n\\r]{0,20}([0-9]{4})(?![0-9])",
    "(?:حساب\\S*|account|a/c)[^0-9\\n\\r]{0,20}([0-9]{4})(?![0-9])",
    "[*Xx•]{2,}\\s*([0-9]{4})(?![0-9])"
  ],
  "examples": [
    {
      "name": "ksa_pos_debit_ar",
      "sender": "AlRajhiBank",
      "text": "عملية شراء\nبطاقة مدى **1234\nمبلغ: 57.50 ر.س\nلدى: STARBUCKS\nفي 2026-07-01",
      "expect": {
        "outcome": "debit",
        "amount": 57.5,
        "currency": "SAR",
        "merchant": "STARBUCKS",
        "last4": "1234"
      }
    },
    {
      "name": "ksa_pos_debit_en",
      "sender": "SNB",
      "text": "Purchase of SAR 89.00 at AMAZON.SA with card ending 5678",
      "expect": {
        "outcome": "debit",
        "amount": 89.0,
        "currency": "SAR",
        "merchant": "AMAZON.SA",
        "last4": "5678"
      }
    },
    {
      "name": "arabic_indic_digits_debit",
      "sender": "AlinmaBank",
      "text": "تم خصم ١٥٠.٥٠ ريال من بطاقتك رقم ٩٨٧٦ لدى مطعم البيك",
      "expect": {
        "outcome": "debit",
        "amount": 150.5,
        "currency": "SAR",
        "merchant": "مطعم البيك",
        "last4": "9876"
      }
    },
    {
      "name": "salary_credit_ar",
      "sender": "Riyad Bank",
      "text": "تم إيداع راتب بمبلغ 12,500.00 ريال في حسابك **3210",
      "expect": {
        "outcome": "credit",
        "amount": 12500.0,
        "currency": "SAR",
        "last4": "3210"
      }
    },
    {
      "name": "incoming_transfer_aed",
      "sender": "EmiratesNBD",
      "text": "حوالة واردة بمبلغ 500 د.إ من AHMED ALI",
      "expect": {
        "outcome": "credit",
        "amount": 500.0,
        "currency": "AED",
        "merchant": "AHMED ALI"
      }
    },
    {
